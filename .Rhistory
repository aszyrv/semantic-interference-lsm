logRT ~
POper*(distr_dissimilarity + consec_dissimilarity) +
PTri*(distr_dissimilarity + consec_dissimilarity) +
IFOF*(distr_dissimilarity + consec_dissimilarity) +
SLF_I*(distr_dissimilarity + consec_dissimilarity) +
