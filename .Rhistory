# ==== Loading packages ====
library(tidyverse)
library(lmerTest)
library(lubridate)
# ==== Reading data ====
pwi_data <- read_csv("pwi_data_clean_withpreds.csv")
demo <- read_csv("data/demo.csv") %>%
mutate(Birth.date = dmy(Birth.date),
Onset.date = dmy(Onset.date),
Behaviour.date = dmy(Behaviour.date),
Age = (Birth.date %--% Behaviour.date)/dyears(x = 1),
Post.onset.weeks = (Onset.date %--% Behaviour.date)/dweeks(x = 1))
pwi_data <- pwi_data %>%
left_join(demo %>% select(ID, Age, Sex, Post.onset.weeks))
# z-scoring continuous predictors
frontal_subset <- c("POper", "PTri", "PreCG", "SLF_I", "SLF_II", "IFOF")
pred_to_zscore <- c("Age", "Post.onset.weeks",
"consec_dissimilarity", "distr_dissimilarity", "logfreq", frontal_subset)
pwi_data[pred_to_zscore] = scale(pwi_data[pred_to_zscore],
center=TRUE, scale=TRUE)
print("z-scoring continuous predictors:")
print(pred_to_zscore)
# sum-coding gender
pwi_data$Sex <- as.factor(pwi_data$Sex)
contrasts(pwi_data$Sex) <- contr.sum(levels(pwi_data$Sex))
print("gender coding:")
print(contrasts(pwi_data$Sex))
# re-leveling the condition variable
pwi_data$Condition <- relevel(as.factor(pwi_data$Condition), "semantic")
print("condition coding:")
print(contrasts(pwi_data$Condition))
#==== Model fitting ====
pwi_model <- lmer(data = pwi_data,
logRT ~
POper*(Condition + consec_dissimilarity) +
PTri*(Condition + consec_dissimilarity) +
SLF_I*(Condition + consec_dissimilarity) +
SLF_II*(Condition + consec_dissimilarity) +
PreCG*(Condition + consec_dissimilarity) +
logfreq + Age + Sex + Post.onset.weeks +
(1|ID) + (1|Critical.segment),
control=lmerControl(optimizer="bobyqa"))
pwi_model_IFOF <- lmer(data = pwi_data,
logRT ~
POper*(Condition + consec_dissimilarity) +
PTri*(Condition + consec_dissimilarity) +
IFOF*(Condition + consec_dissimilarity) +
SLF_I*(Condition + consec_dissimilarity) +
SLF_II*(Condition + consec_dissimilarity) +
PreCG*(Condition + consec_dissimilarity) +
logfreq + Age + Sex + Post.onset.weeks +
(1|ID) + (1|Critical.segment),
control=lmerControl(optimizer="bobyqa"))
print("variance inflation factors:")
print(car::vif(pwi_model))
print(car::vif(pwi_model_IFOF))
print(summary(pwi_model))
print(summary(pwi_model_IFOF))
# model with continuous target-distractor dissimilarity
print("fitting a model with continuous target-distractor dissimilarity")
pwi_model_distrcont <- lmer(data = pwi_data %>% filter(Condition != "congr"),
logRT ~
POper*(distr_dissimilarity + consec_dissimilarity) +
PTri*(distr_dissimilarity + consec_dissimilarity) +
SLF_I*(distr_dissimilarity + consec_dissimilarity) +
SLF_II*(distr_dissimilarity + consec_dissimilarity) +
PreCG*(distr_dissimilarity + consec_dissimilarity) +
Age + Sex + Post.onset.weeks + logfreq +
(1|ID) + (1|Critical.segment),
control=lmerControl(optimizer="bobyqa"))
pwi_model_distrcont_IFOF <- lmer(data = pwi_data %>% filter(Condition != "congr"),
logRT ~
POper*(distr_dissimilarity + consec_dissimilarity) +
PTri*(distr_dissimilarity + consec_dissimilarity) +
IFOF*(distr_dissimilarity + consec_dissimilarity) +
SLF_I*(distr_dissimilarity + consec_dissimilarity) +
SLF_II*(distr_dissimilarity + consec_dissimilarity) +
PreCG*(distr_dissimilarity + consec_dissimilarity) +
Age + Sex + Post.onset.weeks + logfreq +
(1|ID) + (1|Critical.segment),
control=lmerControl(optimizer="bobyqa"))
print("variance inflation factors:")
print(car::vif(pwi_model_distrcont))
print(car::vif(pwi_model_distrcont_IFOF))
print(summary(pwi_model_distrcont))
print(summary(pwi_model_distrcont_IFOF))
# extracting residuals from a model with covariates only to examine how distractor effects change as function of sequential response interference
pwi_model_covar_only <- lmer(data = pwi_data %>% filter(Condition != "congr"),
logRT ~
SLF_I*(Condition + consec_dissimilarity) +
SLF_II*(Condition + consec_dissimilarity) +
PreCG*(Condition + consec_dissimilarity) +
logfreq + Age + Sex + Post.onset.weeks +
(1|Critical.segment),
control=lmerControl(optimizer="bobyqa"))
pwi_residuals <- tibble(pwi_model_covar_only@frame) %>%
bind_cols(fitted = fitted(pwi_model_covar_only),
resid = resid(pwi_model_covar_only)) %>%
left_join(pwi_data %>% select(Age, Sex, Post.onset.weeks, Critical.segment, logRT, ID, POper, PTri)) %>%
mutate(consec_dissim_quart = cut(consec_dissimilarity, 4, label = c("Q1", "Q2", "Q3", "Q4")))
# write_csv(pwi_residuals, "pwi_residuals.csv")
# re-leveling the consec_dissimilarity variable to estimate distractor effects for the lowest level of seq. response interference
pwi_residuals$consec_dissim_quart <- relevel(as.factor(pwi_residuals$consec_dissim_quart), "Q4")
print("condition coding:")
print(contrasts(pwi_residuals$consec_dissim_quart))
print(contrasts(pwi_residuals$Condition))
# simple effect of Lesion loads: general slow-down as function of lesion load WITHIN the related condition and at the lowest level of seq. resp. interference
# two-way interaction Lesion X Condition: whether the slow-down as function of lesion load is weaker in the unrelated vs. related condition, at the lower level of seq. resp. interf.
# three-way interactions: whether increasing seq. resp interference decreases distractor interference
pwi_effect_interaction <- lmer(data = pwi_residuals,
logRT ~
POper*Condition*consec_dissim_quart +
PTri*Condition*consec_dissim_quart +
(1|ID) + (1|Critical.segment),
control=lmerControl(optimizer="bobyqa"))
print(car::vif(pwi_effect_interaction))
print(summary(pwi_effect_interaction))
print(contrasts(pwi_data$consec_dissim_quart))
# have I extracted any extra variance of interest? trying to fit one big model
pwi_data <- pwi_data %>%
mutate(consec_dissim_quart = cut(consec_dissimilarity, 4, label = c("Q1", "Q2", "Q3", "Q4")))
pwi_data$consec_dissim_quart <- relevel(as.factor(pwi_data$consec_dissim_quart), "Q4")
print("condition coding:")
print(contrasts(pwi_data$consec_dissim_quart))
print(contrasts(pwi_data$Condition))
pwi_effect_interaction_fulldata <- lmer(data = pwi_data %>% filter(Condition != "congr"),
logRT ~
POper*Condition*consec_dissim_quart +
PTri*Condition*consec_dissim_quart +
SLF_I*Condition*consec_dissim_quart +
SLF_II*Condition*consec_dissim_quart +
PreCG*Condition*consec_dissim_quart +
logfreq + Age + Sex + Post.onset.weeks +
(1|ID) + (1|Critical.segment),
control=lmerControl(optimizer="bobyqa"))
# have I extracted any extra variance of interest? trying to fit one big model
pwi_data_congexcl <- pwi_data %>%
filter(Condition != "congr") %>%
mutate(consec_dissim_quart = cut(consec_dissimilarity, 4, label = c("Q1", "Q2", "Q3", "Q4")))
pwi_data$consec_dissim_quart <- relevel(as.factor(pwi_data$consec_dissim_quart), "Q4")
print("condition coding:")
print(contrasts(pwi_data$consec_dissim_quart))
print(contrasts(pwi_data$Condition))
pwi_data$Condition <- droplevels(pwi_data$Condition)
print(contrasts(pwi_data$Condition))
# have I extracted any extra variance of interest? trying to fit one big model
pwi_data_congexcl <- pwi_data %>%
mutate(Condition = as.character(Condition)) %>%
filter(Condition != "congr") %>%
mutate(consec_dissim_quart = cut(consec_dissimilarity, 4, label = c("Q1", "Q2", "Q3", "Q4")))
# have I extracted any extra variance of interest? trying to fit one big model
pwi_data_congrexcl <- pwi_data %>%
filter(Condition != "congr") %>%
mutate(consec_dissim_quart = cut(consec_dissimilarity, 4, label = c("Q1", "Q2", "Q3", "Q4")))
pwi_data_congrexcl$consec_dissim_quart <- relevel(as.factor(pwi_data_congrexcl$consec_dissim_quart), "Q4")
print("condition coding:")
print(contrasts(pwi_data_congrexcl$consec_dissim_quart))
pwi_data_congrexcl$Condition <- droplevels(pwi_data_congrexcl$Condition)
print(contrasts(pwi_data_congrexcl$Condition))
pwi_effect_interaction_fulldata <- lmer(data = pwi_data_congrexcl,
logRT ~
POper*Condition*consec_dissim_quart +
PTri*Condition*consec_dissim_quart +
SLF_I*Condition*consec_dissim_quart +
SLF_II*Condition*consec_dissim_quart +
PreCG*Condition*consec_dissim_quart +
logfreq + Age + Sex + Post.onset.weeks +
(1|ID) + (1|Critical.segment),
control=lmerControl(optimizer="bobyqa"))
print(car::vif(pwi_effect_interaction_fulldata))
pwi_effect_interaction_fulldata <- lmer(data = pwi_data_congrexcl,
logRT ~
POper*Condition*consec_dissim_quart +
PTri*Condition*consec_dissim_quart +
SLF_I*Condition*consec_dissim_quart +
SLF_II*Condition +
PreCG*Condition +
logfreq + Age + Sex + Post.onset.weeks +
(1|ID) + (1|Critical.segment),
control=lmerControl(optimizer="bobyqa"))
pwi_effect_interaction_fulldata <- lmer(data = pwi_data_congrexcl,
logRT ~
POper*Condition*consec_dissim_quart +
PTri*Condition*consec_dissim_quart +
SLF_I*Condition +
SLF_II*Condition +
PreCG*Condition +
logfreq + Age + Sex + Post.onset.weeks +
(1|ID) + (1|Critical.segment),
control=lmerControl(optimizer="bobyqa"))
print(car::vif(pwi_effect_interaction_fulldata))
print(summary(pwi_effect_interaction_fulldata))
# modeling interactions between interference effects
# does the unrelated vs. related effect arise under low sequential response interference?
# adding three-way interaction for PTri only, to understand its role in interference resolution, no other effects
pwi_model_effectinter <- lmer(data = pwi_data,
logRT ~
POper*(Condition + consec_dissimilarity) +
PTri*Condition*consec_dissimilarity +
SLF_I*(Condition + consec_dissimilarity) +
SLF_II*(Condition + consec_dissimilarity) +
PreCG*(Condition + consec_dissimilarity) +
logfreq + Age + Sex + Post.onset.weeks +
(1|ID) + (1|Critical.segment),
control=lmerControl(optimizer="bobyqa"))
library(tidyverse)
library(lmerTest)
library(lubridate)
# ==== Reading data ====
pwi_data <- read_csv("pwi_data_clean_withpreds.csv")
demo <- read_csv("data/demo.csv") %>%
mutate(Birth.date = dmy(Birth.date),
Onset.date = dmy(Onset.date),
Behaviour.date = dmy(Behaviour.date),
Age = (Birth.date %--% Behaviour.date)/dyears(x = 1),
Post.onset.weeks = (Onset.date %--% Behaviour.date)/dweeks(x = 1))
pwi_data <- pwi_data %>%
left_join(demo %>% select(ID, Age, Sex, Post.onset.weeks))
# z-scoring continuous predictors
frontal_subset <- c("POper", "PTri", "PreCG", "SLF_I", "SLF_II", "IFOF")
pred_to_zscore <- c("Age", "Post.onset.weeks",
"consec_dissimilarity", "distr_dissimilarity", "logfreq", frontal_subset)
pwi_data[pred_to_zscore] = scale(pwi_data[pred_to_zscore],
center=TRUE, scale=TRUE)
print("z-scoring continuous predictors:")
print(pred_to_zscore)
# sum-coding gender
pwi_data$Sex <- as.factor(pwi_data$Sex)
contrasts(pwi_data$Sex) <- contr.sum(levels(pwi_data$Sex))
print("gender coding:")
print(contrasts(pwi_data$Sex))
# re-leveling the condition variable
pwi_data$Condition <- relevel(as.factor(pwi_data$Condition), "semantic")
print("condition coding:")
print(contrasts(pwi_data$Condition))
#==== Model fitting ====
pwi_model <- lmer(data = pwi_data,
logRT ~
POper*(Condition + consec_dissimilarity) +
PTri*(Condition + consec_dissimilarity) +
SLF_I*(Condition + consec_dissimilarity) +
SLF_II*(Condition + consec_dissimilarity) +
PreCG*(Condition + consec_dissimilarity) +
logfreq + Age + Sex + Post.onset.weeks +
(1|ID) + (1|Critical.segment),
control=lmerControl(optimizer="bobyqa"))
print("variance inflation factors:")
print(car::vif(pwi_model))
print(summary(pwi_model))
# model with continuous target-distractor dissimilarity
print("fitting a model with continuous target-distractor dissimilarity")
pwi_model_distrcont <- lmer(data = pwi_data %>% filter(Condition != "congr"),
logRT ~
POper*(distr_dissimilarity + consec_dissimilarity) +
